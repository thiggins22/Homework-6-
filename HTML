
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Picture Perfect 🧩</title>

  <style>
    :root {
      font-family: system-ui, Arial, sans-serif;
      color: #30244b;
      background: #f7f2ff;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at top left, #eadcff, transparent 55%),
        #f7f2ff;
    }

    .wrap {
      max-width: 980px;
      margin: auto;
      padding: 30px 18px;
      text-align: center;
    }

    h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      margin: 5px 0;
      color: #6542a5;
    }

    p {
      line-height: 1.5;
    }

    .panel {
      background: white;
      border-radius: 24px;
      padding: 24px;
      box-shadow: 0 12px 40px #6542a51a;
      margin: 18px auto;
    }

    button, .upload {
      border: 0;
      border-radius: 13px;
      background: #7651ba;
      color: white;
      padding: 12px 19px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-block;
      margin: 5px;
    }

    button:hover, .upload:hover {
      background: #5b379a;
    }

    button:focus-visible, .upload:focus-visible {
      outline: 3px solid #ffbb45;
      outline-offset: 3px;
    }

    .secondary {
      background: #eee5fa;
      color: #51328b;
    }

    .secondary:hover {
      background: #ddcdf3;
    }

    input[type=file] {
      display: none;
    }

    .choices {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .choices button {
      min-width: 145px;
    }

    .hidden {
      display: none !important;
    }

    .game-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: 22px;
      align-items: start;
    }

    .board {
      display: grid;
      width: 100%;
      max-width: 600px;
      aspect-ratio: 1;
      margin: auto;
      border: 5px solid #7651ba;
      border-radius: 13px;
      overflow: hidden;
      background: #e5d9f5;
      touch-action: manipulation;
    }

    .tile {
      margin: 0;
      border: 1px solid #ffffff80;
      border-radius: 0;
      padding: 0;
      min-width: 0;
      min-height: 0;
      background-repeat: no-repeat;
      background-color: #ddd;
      position: relative;
    }

    .tile:hover {
      filter: brightness(1.09);
    }

    .tile.selected {
      outline: 4px solid #ffc94d;
      outline-offset: -4px;
      z-index: 2;
      filter: brightness(1.12);
    }

    .tile.correct {
      box-shadow: inset 0 0 0 1px #ffffff22;
    }

    .stats {
      display: flex;
      justify-content: center;
      gap: 28px;
      font-size: 1.1rem;
      font-weight: 700;
      flex-wrap: wrap;
    }

    .preview {
      width: 100%;
      border-radius: 12px;
      display: block;
    }

    .sidebar {
      text-align: center;
    }

    .sidebar h3 {
      margin-top: 5px;
    }

    .hint {
      font-size: 0.9rem;
      color: #655d72;
    }

    .win {
      background: #e8ffe8;
      border: 2px solid #8acb9a;
      padding: 18px;
      border-radius: 15px;
      margin: 15px auto;
    }

    .small {
      font-size: 0.9rem;
      color: #766b88;
    }

    @media (max-width: 700px) {
      .game-layout {
        grid-template-columns: 1fr;
      }

      .sidebar {
        max-width: 340px;
        margin: auto;
      }

      .panel {
        padding: 15px;
      }

      .wrap {
        padding: 18px 10px;
      }
    }
  </style>
</head>

<body>
  <main class="wrap">

    <h1>🧩 Picture Perfect</h1>
    <p>Turn your favorite photo into a puzzle!</p>

    <!-- SETUP SCREEN -->
    <section class="panel" id="setup">

      <h2>1. Choose your photo</h2>
      <p>Upload a picture from your device to create your own puzzle.</p>

      <label class="upload" for="file">
        📷 Upload a picture
      </label>

      <input id="file" type="file" accept="image/*">

      <p id="filename" class="small">
        No photo selected yet
      </p>

      <div id="difficulty" class="hidden">
        <h2>2. Pick your difficulty</h2>

        <div class="choices">
          <button data-level="easy">
            Easy<br>25 pieces
          </button>

          <button data-level="medium">
            Medium<br>50 pieces
          </button>

          <button data-level="hard">
            Hard<br>100 pieces
          </button>
        </div>
      </div>

    </section>

    <!-- GAME SCREEN -->
    <section class="panel hidden" id="game">

      <div class="stats">
        <span>
          ⏱️ Time: <span id="time">0:00</span>
        </span>

        <span>
          🔁 Moves: <span id="moves">0</span>
        </span>

        <span>
          🧩 <span id="level"></span>
        </span>
      </div>

      <p class="hint">
        Click one piece, then another to swap them.
        Put the photo back together to win!
      </p>

      <div class="game-layout">

        <div>
          <div
            id="board"
            class="board"
            aria-label="Picture puzzle">
          </div>

          <!-- WINNING SCREEN -->
          <div id="win" class="win hidden" role="status">
            <h2>🎉 Puzzle complete!</h2>

            <p id="result"></p>

            <button id="again">
              Play again
            </button>
          </div>
        </div>

        <!-- SIDEBAR -->
        <aside class="sidebar">

          <h3>Original picture</h3>

          <img
            id="preview"
            class="preview"
            alt="Your original uploaded picture">

          <p class="hint">
            Use this as a guide!
          </p>

          <button class="secondary" id="toggle">
            Hide preview
          </button>

          <button class="secondary" id="shuffle">
            🔀 Shuffle again
          </button>

          <button class="secondary" id="new">
            📷 New picture
          </button>

        </aside>
      </div>
    </section>
  </main>

  <script>
    // GET HTML ELEMENTS
    const file = document.getElementById('file');
    const difficulty = document.getElementById('difficulty');
    const setup = document.getElementById('setup');
    const game = document.getElementById('game');
    const board = document.getElementById('board');
    const preview = document.getElementById('preview');

    // GAME VARIABLES
    let imageURL = null;
    let positions = [];
    let rows = 5;
    let cols = 5;
    let selected = null;
    let moves = 0;
    let start = 0;
    let ticker = null;
    let finished = false;

    // STEP 1: UPLOAD A PHOTO
    file.addEventListener('change', () => {
      const f = file.files[0];

      if (!f) return;

      if (!f.type.startsWith('image/')) {
        alert('Please choose an image file.');
        return;
      }

      if (imageURL) {
        URL.revokeObjectURL(imageURL);
      }

      imageURL = URL.createObjectURL(f);

      document.getElementById('filename').textContent = f.name;

      difficulty.classList.remove('hidden');
    });

    // STEP 2: SELECT DIFFICULTY
    document.querySelectorAll('[data-level]').forEach(b => {
      b.addEventListener('click', () => {
        if (!imageURL) return;

        const level = b.dataset.level;

        rows = level === 'hard' ? 10 : 5;
        cols = level === 'easy' ? 5 : 10;

        document.getElementById('level').textContent =
          level[0].toUpperCase() + level.slice(1);

        preview.src = imageURL;

        setup.classList.add('hidden');
        game.classList.remove('hidden');

        preview.classList.remove('hidden');

        document.getElementById('toggle').textContent =
          'Hide preview';

        reset();
      });
    });

    // STEP 3: START OR RESET THE GAME
    function reset() {
      clearInterval(ticker);

      finished = false;
      selected = null;
      moves = 0;

      document.getElementById('moves').textContent = 0;
      document.getElementById('win').classList.add('hidden');

      const n = rows * cols;

      // Create numbered puzzle pieces
      positions = Array.from(
        { length: n },
        (_, i) => i
      );

      // Shuffle pieces randomly
      do {
        for (let i = n - 1; i > 0; i--) {
          let j = Math.floor(Math.random() * (i + 1));

          [positions[i], positions[j]] =
            [positions[j], positions[i]];
        }
      } while (
        positions.every((x, i) => x === i)
      );

      // Start timer
      start = Date.now();

      updateTime();

      ticker = setInterval(updateTime, 500);

      draw();
    }

    // STEP 4: TIMER
    function updateTime() {
      let s = Math.floor((Date.now() - start) / 1000);

      document.getElementById('time').textContent =
        Math.floor(s / 60) + ':' +
        String(s % 60).padStart(2, '0');
    }

    // STEP 5: DRAW PUZZLE PIECES
    function draw() {
      board.style.gridTemplateColumns =
        `repeat(${cols}, 1fr)`;

      board.style.gridTemplateRows =
        `repeat(${rows}, 1fr)`;

      board.innerHTML = '';

      positions.forEach((piece, i) => {
        const b = document.createElement('button');

        b.type = 'button';

        b.className =
          'tile' +
          (selected === i ? ' selected' : '') +
          (piece === i ? ' correct' : '');

        b.setAttribute(
          'aria-label',
          `Puzzle position ${i + 1}, piece ${piece + 1}`
        );

        b.setAttribute(
          'aria-pressed',
          String(selected === i)
        );

        b.style.backgroundImage = `url("${imageURL}")`;

        b.style.backgroundSize =
          `${cols * 100}% ${rows * 100}%`;

        b.style.backgroundPosition =
          `${(piece % cols) * 100 / (cols - 1)}% ` +
          `${Math.floor(piece / cols) * 100 / (rows - 1)}%`;

        b.addEventListener('click', () => choose(i));

        board.appendChild(b);
      });
    }

    // STEP 6: SWAP TWO PUZZLE PIECES
    function choose(i) {
      if (finished) return;

      // Select the first piece
      if (selected === null) {
        selected = i;
        draw();
        return;
      }

      // Deselect if same piece is clicked
      if (selected === i) {
        selected = null;
        draw();
        return;
      }

      // Swap selected pieces
      [positions[selected], positions[i]] =
        [positions[i], positions[selected]];

      selected = null;

      // Increase move counter
      moves++;

      document.getElementById('moves').textContent = moves;

      draw();

      // STEP 7: CHECK IF PLAYER WON
      if (positions.every((p, j) => p === j)) {
        finished = true;

        // Stop timer
        clearInterval(ticker);

        updateTime();

        const finalTime =
          document.getElementById('time').textContent;

        document.getElementById('result').textContent =
          `You solved your photo in ${finalTime} ` +
          `with ${moves} moves!`;

        document.getElementById('win')
          .classList.remove('hidden');
      }
    }

    // SHUFFLE BUTTON
    document.getElementById('shuffle')
      .addEventListener('click', reset);

    // SHOW OR HIDE ORIGINAL PHOTO
    document.getElementById('toggle')
      .addEventListener('click', () => {
        const hidden = preview.classList.toggle('hidden');

        document.getElementById('toggle').textContent =
          hidden ? 'Show preview' : 'Hide preview';
      });

    // NEW PICTURE BUTTON
    function newPicture() {
      clearInterval(ticker);

      game.classList.add('hidden');
      setup.classList.remove('hidden');
      difficulty.classList.add('hidden');

      file.value = '';

      document.getElementById('filename').textContent =
        'No photo selected yet';
    }

    document.getElementById('new')
      .addEventListener('click', newPicture);

    // PLAY AGAIN BUTTON
    document.getElementById('again')
      .addEventListener('click', () => {
        game.classList.add('hidden');
        setup.classList.remove('hidden');
        difficulty.classList.remove('hidden');
      });
  </script>
</body>
</html>
